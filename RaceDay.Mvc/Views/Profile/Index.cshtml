@model ProfileVm
@{ViewData["Title"]="My profile";}<div class="row justify-content-center"><div class="col-md-7"><div class="card card-body"><h1>My profile</h1>@if(!string.IsNullOrWhiteSpace(ViewBag.ProfilePictureUrl as string)){<img src="@ViewBag.ProfilePictureUrl" alt="Your profile picture" class="rounded-circle mb-3" style="width:120px;height:120px;object-fit:cover"/>}<p class="text-secondary">Update your personal information and profile picture.</p><form method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control mb-3"/><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control mb-3"/>@if(Context.Session.GetString("Role")=="Participant"){<label asp-for="Picture" class="form-label">Profile picture (JPG, PNG or WEBP; max 5 MB)</label><input asp-for="Picture" type="file" accept="image/png,image/jpeg,image/webp" class="form-control mb-3"/>}<button class="btn btn-race">Save changes</button></form></div></div></div>
