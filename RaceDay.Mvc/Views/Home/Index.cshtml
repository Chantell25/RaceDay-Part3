@model JsonElement
@{ViewData["Title"]="Upcoming races";}
<section class="hero mb-4"><span class="badge bg-warning text-dark mb-3">RACE YOUR WAY</span><h1 class="display-5 fw-bold">Find your next finish line.</h1><p class="lead">Discover races, choose your distance and make every kilometre count.</p></section>
<form method="get" class="card card-body mb-4"><div class="row g-2"><div class="col-md-5"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search event name"/></div><div class="col-md-4"><input name="city" value="@ViewBag.City" class="form-control" placeholder="Filter by city"/></div><div class="col-md-2"><input type="date" name="fromDate" class="form-control"/></div><div class="col-md-1 d-grid"><button class="btn btn-race">Go</button></div></div></form>
<div class="d-flex justify-content-between align-items-center mb-3"><h2>Upcoming events</h2><span class="text-secondary">@Model.GetArrayLength() events found</span></div><div class="row g-4">
@if(Model.ValueKind==JsonValueKind.Array){@foreach(var e in Model.EnumerateArray()){<div class="col-md-6 col-lg-4"><div class="card h-100">@if(e.TryGetProperty("bannerUrl",out var banner)&&banner.ValueKind==JsonValueKind.String&&!string.IsNullOrWhiteSpace(banner.GetString())){<img src="@banner.GetString()" class="card-img-top" alt="Banner for @e.GetProperty("eventName").GetString()" style="height:180px;object-fit:cover"/>}<div class="card-body"><span class="badge text-bg-dark mb-2">@e.GetProperty("status").GetString()</span><h4>@e.GetProperty("eventName").GetString()</h4><small class="text-uppercase text-secondary">@e.GetProperty("eventType").GetString()</small><p class="text-secondary mb-1">📍 @e.GetProperty("venue").GetString(), @e.GetProperty("city").GetString()</p><p>📅 @e.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy, HH:mm")</p><p>@(e.GetProperty("description").ValueKind==JsonValueKind.Null?"Join the RaceDay community for this event.":e.GetProperty("description").GetString())</p><a class="btn btn-race" asp-controller="Participant" asp-action="Details" asp-route-id="@e.GetProperty("eventId").GetInt32()">View event</a></div></div></div>}}</div>
