@model LoginVm
@{ViewData["Title"]="Login";}<div class="row justify-content-center"><div class="col-md-6 col-lg-5"><div class="card card-body"><h2>Welcome back</h2><p class="text-secondary">Sign in to continue your RaceDay journey.</p><form method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control mb-3"/><span asp-validation-for="Email" class="text-danger"></span><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control mb-3"/><span asp-validation-for="Password" class="text-danger"></span><button class="btn btn-race w-100">Login</button></form><p class="mt-3">New to RaceDay? <a asp-action="Register">Create an account</a></p></div></div></div>
