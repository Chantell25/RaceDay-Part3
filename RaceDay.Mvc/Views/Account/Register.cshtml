@model RegisterVm
@{
    ViewData["Title"] = "Register";
}
<div class="row justify-content-center"><div class="col-md-8"><div class="card card-body"><h2>Create your RaceDay account</h2><form method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><div class="row"><div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control mb-3"/></div><div class="col-md-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control mb-3"/></div></div><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control mb-3"/><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control mb-3"/><label asp-for="Role" class="form-label"></label><select asp-for="Role" class="form-select mb-3" id="role"><option>Participant</option><option>Organiser</option></select><div id="org"><label asp-for="OrganisationName" class="form-label"></label><input asp-for="OrganisationName" class="form-control mb-3"/><label asp-for="ContactNumber" class="form-label"></label><input asp-for="ContactNumber" class="form-control mb-3"/></div><label asp-for="DateOfBirth" class="form-label"></label><input asp-for="DateOfBirth" type="date" class="form-control mb-3"/><button class="btn btn-race">Register</button></form></div></div></div>

@section Scripts {
    <script>
        const role = document.getElementById('role'), org = document.getElementById('org');
        function toggle() { org.hidden = role.value !== 'Organiser'; }
        role.addEventListener('change', toggle);
        toggle();
    </script>
}
