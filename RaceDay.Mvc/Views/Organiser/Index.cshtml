@model JsonElement
@{ViewData["Title"]="Organiser dashboard";}<div class="d-flex justify-content-between align-items-center mb-4"><div><h1>Organiser dashboard</h1><p class="text-secondary">Manage your events and race-day operations.</p></div><a asp-action="Create" class="btn btn-race">+ Create event</a></div><div class="row g-3 mb-4"><div class="col-md-4"><div class="card card-body"><small class="text-secondary">Events created</small><h2>@Model.GetArrayLength()</h2></div></div><div class="col-md-4"><div class="card card-body"><small class="text-secondary">Total enrolments</small><h2>@(Model.EnumerateArray().Sum(x=>x.GetProperty("enrolmentCount").GetInt32()))</h2></div></div><div class="col-md-4"><div class="card card-body"><small class="text-secondary">Results captured</small><h2>@(Model.EnumerateArray().Sum(x=>x.GetProperty("resultCount").GetInt32()))</h2></div></div></div><div class="card card-body"><div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>City</th><th>Enrolments</th><th>Actions</th></tr></thead><tbody>@foreach(var e in Model.EnumerateArray()){<tr><td><strong>@e.GetProperty("eventName").GetString()</strong><br/><small>@e.GetProperty("status").GetString()</small></td><td>@e.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy")</td><td>@e.GetProperty("city").GetString()</td><td>@e.GetProperty("enrolmentCount").GetInt32()</td><td><a asp-action="Edit" asp-route-id="@e.GetProperty("eventId").GetInt32()">Edit</a> · <a asp-action="Categories" asp-route-id="@e.GetProperty("eventId").GetInt32()">Categories</a> · <a asp-action="Enrolments" asp-route-id="@e.GetProperty("eventId").GetInt32()">Enrolments/results</a><form asp-action="Delete" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.GetProperty("eventId").GetInt32()"/><button class="btn btn-sm btn-link text-danger" onclick="return confirm('Delete this event?')">Delete</button></form></td></tr>}</tbody></table></div></div>
