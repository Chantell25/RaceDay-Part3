@model EventVm
@{ViewData["Title"]="Event details";}
<div class="card card-body"><h2>@(Model.EventId==0?"Create event":"Edit event")</h2><form method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><input asp-for="EventId" type="hidden"/><label asp-for="EventName" class="form-label"></label><input asp-for="EventName" class="form-control mb-3"/><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control mb-3"></textarea><label asp-for="EventDate" class="form-label"></label><input asp-for="EventDate" type="datetime-local" class="form-control mb-3"/><label asp-for="Venue" class="form-label"></label><input asp-for="Venue" class="form-control mb-3"/><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control mb-3"/><label asp-for="EventType" class="form-label"></label><select asp-for="EventType" class="form-select mb-3"><option>Road Race</option><option>Trail Run</option><option>Fun Run</option><option>Marathon</option><option>Charity Run</option></select><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select mb-3"><option>Planned</option><option>Open</option><option>Completed</option><option>Cancelled</option></select><label asp-for="Banner" class="form-label">Event banner image</label><input asp-for="Banner" type="file" accept="image/png,image/jpeg,image/webp" class="form-control mb-3"/><button class="btn btn-race">Save event</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form></div>
