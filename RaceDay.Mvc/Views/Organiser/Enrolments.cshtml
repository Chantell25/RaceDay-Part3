@model JsonElement
@{ViewData["Title"]="Enrolments and results";}<h1>Event enrolments and results</h1><div class="card card-body"><div class="table-responsive"><table class="table"><thead><tr><th>Participant</th><th>Email</th><th>Category</th><th>Race #</th><th>Enrolment</th><th>Published result</th><th>Capture/update result</th></tr></thead><tbody>@foreach(var e in Model.EnumerateArray()){<tr><td>@e.GetProperty("participant").GetString()</td><td>@e.GetProperty("email").GetString()</td><td>@e.GetProperty("category").GetString()</td><td>@e.GetProperty("raceNumber").GetInt32()</td><td><span class="badge @(e.GetProperty("status").GetString()=="Confirmed"?"bg-success":"bg-warning text-dark")">@e.GetProperty("status").GetString()</span></td><td>@(e.GetProperty("position").ValueKind==JsonValueKind.Null?"Not published":"#"+e.GetProperty("position").ToString())<br/><small>@(e.GetProperty("finishTime").ValueKind==JsonValueKind.Null?"":e.GetProperty("finishTime").ToString())</small></td><td><form asp-action="RecordResult" method="post" class="d-flex gap-1 flex-wrap">@Html.AntiForgeryToken()<input type="hidden" name="eventId" value="@ViewBag.EventId"/><input type="hidden" name="enrollmentId" value="@e.GetProperty("enrollmentId").GetInt32()"/><input type="hidden" name="resultId" value="@(e.GetProperty("resultId").ValueKind==JsonValueKind.Null?"":e.GetProperty("resultId").ToString())"/><input name="finishTime" value="@(e.GetProperty("finishTime").ValueKind==JsonValueKind.Null?"":e.GetProperty("finishTime").ToString())" class="form-control form-control-sm" placeholder="01:12:30" style="width:105px"/><input name="position" type="number" min="1" value="@(e.GetProperty("position").ValueKind==JsonValueKind.Null?"":e.GetProperty("position").ToString())" class="form-control form-control-sm" placeholder="Position" style="width:90px"/><button class="btn btn-sm btn-race">@(e.GetProperty("resultId").ValueKind==JsonValueKind.Null?"Publish":"Update")</button></form></td></tr>}</tbody></table></div></div>
