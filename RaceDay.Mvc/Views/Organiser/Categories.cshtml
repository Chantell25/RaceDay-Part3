@model JsonElement
@{ViewData["Title"]="Event categories";}<h1>Categories</h1><div class="card card-body mb-4"><h4>Add age or distance category</h4><form asp-action="AddCategory" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@ViewBag.EventId"/><div class="row g-2"><div class="col"><input name="CategoryName" class="form-control" placeholder="Category name (e.g. 10 km Open)" required/></div><div class="col"><input name="DistanceKm" type="number" step=".1" min=".1" class="form-control" placeholder="Distance km" required/></div><div class="col"><input name="MaxParticipants" type="number" min="1" class="form-control" placeholder="Capacity" required/></div><div class="col"><input name="EntryFee" type="number" step=".01" min="0" class="form-control" placeholder="Entry fee" required/></div><div class="col-auto"><button class="btn btn-race">Add</button></div></div></form></div><div class="card card-body"><table class="table"><thead><tr><th>Category</th><th>Distance</th><th>Capacity</th><th>Fee</th><th></th></tr></thead><tbody>@foreach(var c in Model.EnumerateArray()){<tr><td>@c.GetProperty("categoryName").GetString()</td><td>@c.GetProperty("distanceKm").GetDecimal() km</td><td>@c.GetProperty("maxParticipants").GetInt32()</td><td>R @c.GetProperty("entryFee").GetDecimal()</td><td><form asp-action="DeleteCategory" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.GetProperty("categoryId").GetInt32()"/><input type="hidden" name="eventId" value="@ViewBag.EventId"/><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>}</tbody></table></div>
