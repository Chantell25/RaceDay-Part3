@model JsonElement
@{ViewData["Title"]="My results";}<h1>My race history</h1><div class="card card-body"><table class="table"><thead><tr><th>Event</th><th>Category</th><th>Finish time</th><th>Position</th><th>Result status</th></tr></thead><tbody>@foreach(var e in Model.EnumerateArray()){<tr><td>@e.GetProperty("eventName").GetString()</td><td>@e.GetProperty("category").GetString()</td><td>@(e.GetProperty("finishTime").ValueKind==JsonValueKind.Null?"—":e.GetProperty("finishTime").ToString())</td><td>@(e.GetProperty("position").ValueKind==JsonValueKind.Null?"—":e.GetProperty("position").ToString())</td><td>@e.GetProperty("resultStatus").GetString()</td></tr>}</tbody></table></div>
