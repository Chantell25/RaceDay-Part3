@model JsonElement
@{ViewData["Title"]=Model.GetProperty("eventName").GetString();}@if(Model.TryGetProperty("bannerUrl",out var banner)&&banner.ValueKind==JsonValueKind.String&&!string.IsNullOrWhiteSpace(banner.GetString())){<img src="@banner.GetString()" class="img-fluid rounded-4 mb-3 w-100" style="max-height:320px;object-fit:cover" alt="Event banner"/>}<div class="hero mb-4"><h1>@Model.GetProperty("eventName").GetString()</h1><p>@Model.GetProperty("description").GetString()</p></div><div class="card card-body mb-4"><h4>Event information</h4><p><strong>Type:</strong> @Model.GetProperty("eventType").GetString()</p><p>📅 @Model.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy HH:mm")</p><p>📍 @Model.GetProperty("venue").GetString(), @Model.GetProperty("city").GetString()</p><h4>Available categories</h4>@foreach(var c in Model.GetProperty("categories").EnumerateArray()){<div class="border rounded p-3 mb-2 d-flex justify-content-between align-items-center"><div><strong>@c.GetProperty("categoryName").GetString()</strong><div>@c.GetProperty("distanceKm").GetDecimal() km · Capacity @c.GetProperty("maxParticipants").GetInt32() · R @c.GetProperty("entryFee").GetDecimal()</div></div>@if(Context.Session.GetString("Role")=="Participant"){<form asp-action="Enrol" method="post">@Html.AntiForgeryToken()<input type="hidden" name="eventId" value="@Model.GetProperty("eventId").GetInt32()"/><input type="hidden" name="categoryId" value="@c.GetProperty("categoryId").GetInt32()"/><button class="btn btn-race">Enrol</button></form>}</div>}</div>
