@model JsonElement
@{ViewData["Title"]="My events";}<h1>My enrolled events</h1><div class="card card-body"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Race number</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var e in Model.EnumerateArray()){<tr><td>@e.GetProperty("eventName").GetString()</td><td>@e.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy")</td><td>@e.GetProperty("categoryName").GetString()</td><td>@e.GetProperty("raceNumber").GetInt32()</td><td><span class="badge @(e.GetProperty("status").GetString()=="Confirmed"?"bg-success":"bg-warning text-dark")">@e.GetProperty("status").GetString()</span></td><td><form asp-action="Cancel" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.GetProperty("enrollmentId").GetInt32()"/><button class="btn btn-sm btn-outline-danger">Cancel</button></form></td></tr>}</tbody></table></div>
