<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - RaceDay</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link rel="stylesheet" href="~/css/site.css"/></head><body><nav class="navbar navbar-expand-lg navbar-dark bg-dark"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🏁 RaceDay</a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><div class="navbar-nav ms-auto"><a class="nav-link" asp-controller="Home" asp-action="Index">Events</a>@if(Context.Session.GetString("Role")=="Organiser"){<a class="nav-link" asp-controller="Organiser" asp-action="Index">Organiser Dashboard</a>}@if(Context.Session.GetString("Role")=="Participant"){<a class="nav-link" asp-controller="Participant" asp-action="Index">My Events</a><a class="nav-link" asp-controller="Participant" asp-action="Results">My Results</a>}@if(Context.Session.GetString("Role")!=null){<a class="nav-link" asp-controller="Profile" asp-action="Index">Profile</a><a class="nav-link" asp-controller="Account" asp-action="Logout">Logout</a>}else{<a class="nav-link" asp-controller="Account" asp-action="Login">Login</a><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a>}</div></div></div></nav><main class="container py-4">@if(TempData["Success"]!=null){<div class="alert alert-success">@TempData["Success"]</div>}@if(TempData["Error"]!=null){<div class="alert alert-warning">@TempData["Error"]</div>}@RenderBody()</main><footer class="text-center py-4 text-secondary">© @DateTime.Now.Year RaceDay · Run together. Go further.</footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>